# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Duplikium (trade-copier.com): copies the master account's trades onto each client's MT5 account ---
# Secrets go only into Render's Environment page, never into chat or GitHub.
DUPLIKIUM_API_USER=""
DUPLIKIUM_API_TOKEN=""
# The Duplikium id of your master account and of the default slave template (see DEPLOY.md)
DUPLIKIUM_MASTER_ID=""
DUPLIKIUM_TEMPLATE_ID=""

# Firebase project used to check who is signed in (defaults come from firebase-applet-config.json)
# FIREBASE_PROJECT_ID="elaborate-analogy-jvxch"
# FIREBASE_DATABASE_ID="ai-studio-castimofxtrading-565afdce-97c9-43a1-82b2-a473a0715999"


# Your real USDT (TRC20) wallet address. Payments stay switched off until this is set.
VITE_TREASURY_ADDRESS=""

# --- Client connect (all optional; these are the defaults) ---
# How long the browser waits for a new connection. A slow broker is not a failure: when the time is up the
# connection keeps going in the background and the dashboard updates by itself.
# CONNECT_SYNC_WAIT_SECONDS=120
# CONNECT_PROBE_MS=5000         # how often a connecting client's login is looked at (the first look is 20% later)
# CONNECT_KEEP_READS=3          # when reads are scarce, this many are kept free for seeing the login (the duplicate check uses the last list)
# CONNECT_MAX_PARALLEL=3        # connections started at the same time; others wait their turn and are told so
# MAX_CLIENT_ACCOUNTS=0         # 0 = no limit; set it to what your Duplikium plan includes
# MAX_ACCOUNTS_PER_USER=1
# MIN_CONNECT_EQUITY=200        # equity an account needs for trades to be copied; below it the account still connects, but waits
# DUPLIKIUM_REFRESH_SECONDS=60
# DUPLIKIUM_TIMEZONE=Europe/Paris  # the zone Duplikium writes trade times in (checked live: MT5 14:15 on HFM GMT+2 = Duplikium 13:15)
# DUPLIKIUM_RISK_TYPE=          # copy size for new clients; if unset, the template's own is used
# DUPLIKIUM_RISK_VALUE=

# Email confirmation codes (optional; from resend.com, with a verified sending domain).
# RESEND_API_KEY=""
# EMAIL_FROM="Castimofx <noreply@castimofx.com>"

# Security. TRUST_PROXY_HOPS = proxies in front of the server (1 = Render alone, 2 = Render behind Cloudflare).
# RATE_LIMIT_OFF=1 switches the request limits off (emergency only).
# TRUST_PROXY_HOPS=1
# RATE_LIMIT_OFF=

# Android app (Google Play). Both must be valid before /.well-known/assetlinks.json is served.
# ANDROID_PACKAGE_NAME="com.castimofx.app"
# ANDROID_SHA256_FINGERPRINTS="AB:CD:...:EF"   # 32 pairs; several can be separated by commas or new lines
