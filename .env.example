# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# METAAPI_TOKEN: Access token from https://app.metaapi.cloud
METAAPI_TOKEN=""

# MASTER_ACCOUNT_ID: The MetaApi Account ID for your Master MT5 terminal
MASTER_ACCOUNT_ID=""

# Firebase project used to check who is signed in (defaults come from firebase-applet-config.json)
# FIREBASE_PROJECT_ID="elaborate-analogy-jvxch"
# FIREBASE_DATABASE_ID="ai-studio-castimofxtrading-565afdce-97c9-43a1-82b2-a473a0715999"


# Your real USDT (TRC20) wallet address. Payments stay switched off until this is set.
VITE_TREASURY_ADDRESS=""

# --- Client connect (all optional; these are the defaults) ---
# How long the browser waits on each step. A slow broker is not a failure: when the time is up the terminal
# keeps connecting in the background (the terminal supervisor, see DEPLOY.md) and the dashboard updates by itself.
# CONNECT_CREATE_WAIT_SECONDS=120
# CONNECT_DEPLOY_WAIT_SECONDS=120
# CONNECT_SYNC_WAIT_SECONDS=90
# CONNECT_MAX_PARALLEL=3        # terminals started at the same time; others wait their turn and are told so
# SUPERVISOR_MAX_PARALLEL=4     # terminals the background supervisor looks at at the same time
# MAX_CLIENT_ACCOUNTS=5
# MAX_ACCOUNTS_PER_USER=1
# MIN_CONNECT_EQUITY=200
# METAAPI_CLIENT_REGION=london   # new-york, london or singapore: pick the one nearest your brokers

# Email confirmation codes (optional; from resend.com, with a verified sending domain).
# RESEND_API_KEY=""
# EMAIL_FROM="CASTIMOFX <noreply@castimofx.com>"
