{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with role, email, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Full name or alias" },
        "role": { "type": "string", "enum": ["client", "admin"], "description": "User authorization role" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "updatedAt": { "type": "string", "description": "ISO timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Client trading subscription plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Subscription ID" },
        "userId": { "type": "string", "description": "User ID" },
        "planId": { "type": "string", "enum": ["weekly", "monthly"], "description": "Plan identifier" },
        "planName": { "type": "string", "description": "Plan display name" },
        "priceUsdt": { "type": "number", "description": "Price in TRC20 USDT" },
        "status": {
          "type": "string",
          "enum": ["pending_payment", "payment_submitted", "payment_confirming", "active", "expiring", "expired", "suspended", "cancelled"],
          "description": "Subscription status"
        },
        "txHash": { "type": "string", "description": "TRC20 Transaction hash" },
        "confirmations": { "type": "number", "description": "Block confirmations" },
        "startDate": { "type": "string", "description": "Start timestamp" },
        "expiresAt": { "type": "string", "description": "Expiration timestamp" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "planId", "status"]
    },
    "Mt5Account": {
      "title": "MT5 Account",
      "description": "Client MT5 connection state without storing raw credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Account ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "accountNumber": { "type": "string", "description": "MT5 Account Number" },
        "brokerServer": { "type": "string", "description": "Broker server name" },
        "status": {
          "type": "string",
          "enum": ["pending", "connecting", "connected", "copying", "connection_failed", "disconnect_requested", "closing_positions", "disconnected", "disconnect_failed", "blocked"],
          "description": "Current MT5 bridge state"
        },
        "balance": { "type": "number", "description": "Current balance in USD" },
        "equity": { "type": "number", "description": "Current equity in USD" },
        "freeMargin": { "type": "number", "description": "Current free margin in USD" },
        "marginLevel": { "type": "number", "description": "Margin level percentage" },
        "leverage": { "type": "number", "description": "Account leverage" },
        "riskStatus": { "type": "string", "enum": ["normal", "warning", "blocked"], "description": "Risk engine assessment" },
        "blockedReason": { "type": "string", "description": "Reason for trade blocking" },
        "lastPing": { "type": "string", "description": "Last heartbeat from bridge" },
        "createdAt": { "type": "string", "description": "Connection date" }
      },
      "required": ["id", "userId", "accountNumber", "brokerServer", "status"]
    },
    "WithdrawalRequest": {
      "title": "Withdrawal Request",
      "description": "Client withdrawal request with safety locks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Withdrawal request ID" },
        "userId": { "type": "string", "description": "Client ID" },
        "amount": { "type": "number", "description": "Requested amount in USDT" },
        "destinationAddress": { "type": "string", "description": "TRC20 USDT payout address" },
        "status": {
          "type": "string",
          "enum": ["requested", "blocked", "reserved", "approved", "processing", "paid", "rejected", "cancelled"],
          "description": "Withdrawal lifecycle status"
        },
        "estimatedWithdrawableAtRequest": { "type": "number", "description": "Snapshot of calculated withdrawable at submission" },
        "hasOpenTrades": { "type": "boolean", "description": "Whether open positions existed at request time" },
        "rejectionReason": { "type": "string", "description": "Rejection note if any" },
        "createdAt": { "type": "string", "description": "Request timestamp" }
      },
      "required": ["id", "userId", "amount", "destinationAddress", "status"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Security and financial audit record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry ID" },
        "userId": { "type": "string", "description": "Actor user ID" },
        "action": { "type": "string", "description": "Action performed" },
        "category": { "type": "string", "description": "Category (AUTH, MT5, RISK, WITHDRAWAL, PAYMENT, SETTLEMENT)" },
        "details": { "type": "string", "description": "Sanitized description" },
        "ip": { "type": "string", "description": "Origin IP address" },
        "timestamp": { "type": "string", "description": "UTC timestamp" },
        "status": { "type": "string", "description": "SUCCESS or FAILURE" }
      },
      "required": ["id", "action", "category", "timestamp"]
    },
    "EmailVerification": {
      "title": "Email Verification",
      "description": "Email verification OTP code record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Verification ID or encoded email" },
        "email": { "type": "string", "description": "Target email address" },
        "code": { "type": "string", "description": "6-digit verification code" },
        "expiresAt": { "type": "string", "description": "Expiration ISO timestamp" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "verified": { "type": "boolean", "description": "Verification status" },
        "attempts": { "type": "number", "description": "Number of validation attempts" }
      },
      "required": ["id", "email", "code", "expiresAt", "verified"]
    },
    "UserYieldAllocation": {
      "title": "User Yield Allocation",
      "description": "Fixed capital 2.0% daily (Mon-Fri) for 100 business days performance pool allocation tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Allocation record identifier" },
        "userId": { "type": "string", "description": "Client user UID" },
        "allocatedAmountUsdt": { "type": "number", "description": "Fixed principal allocated to the yield pool" },
        "walletBalanceUsdt": { "type": "number", "description": "Current available withdrawable yield balance" },
        "totalYieldEarnedUsdt": { "type": "number", "description": "Total cumulative fixed 2% daily yield earned" },
        "dailyRatePct": { "type": "number", "description": "Fixed business-day rate percentage (2.0%)" },
        "businessDaysCompleted": { "type": "number", "description": "Completed Mon-Fri business payout days (0-100)" },
        "termBusinessDays": { "type": "number", "description": "Total fixed term length in business days (100)" },
        "status": { "type": "string", "enum": ["active", "paused", "pending", "completed"], "description": "Pool participation status" },
        "lastDistributionAt": { "type": "string", "description": "ISO timestamp of last yield distribution" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["id", "userId", "allocatedAmountUsdt", "status"]
    },
    "YieldLedgerEntry": {
      "title": "Yield Ledger Entry",
      "description": "Transaction and audit entry for yield pool allocations, distributions, and withdrawals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Ledger entry UUID" },
        "userId": { "type": "string", "description": "Client user UID" },
        "allocationId": { "type": "string", "description": "Associated allocation ID" },
        "type": { "type": "string", "enum": ["allocation", "yield_distribution", "withdrawal_request"], "description": "Entry category" },
        "amount": { "type": "number", "description": "Gross amount in USDT" },
        "netAmount": { "type": "number", "description": "Net credited or debited amount in USDT" },
        "feeAmount": { "type": "number", "description": "Transaction or network fee if applicable" },
        "txHash": { "type": "string", "description": "TRC20 transaction hash" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "active", "rejected", "completed"], "description": "Ledger status" },
        "description": { "type": "string", "description": "Human-readable transaction description" },
        "network": { "type": "string", "description": "Blockchain or settlement network" },
        "recipientAddress": { "type": "string", "description": "Destination address for withdrawals" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "confirmedAt": { "type": "string", "description": "ISO timestamp of confirmation" }
      },
      "required": ["id", "userId", "type", "amount", "netAmount", "status", "createdAt"]
    },
    "YieldPosition": {
      "title": "Yield Position",
      "description": "Individual fixed-capital 100-business-day yield tranche created upon TRON verification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Position ID" },
        "userId": { "type": "string", "description": "Client user UID" },
        "principalUsdt": { "type": "number", "description": "Verified TRC20 USDT principal" },
        "dailyRatePct": { "type": "number", "description": "Fixed 2.0% daily rate" },
        "dailyPayoutUsdt": { "type": "number", "description": "Fixed daily payout in USDT" },
        "businessDaysCompleted": { "type": "number", "description": "Payout days completed (0-100)" },
        "termBusinessDays": { "type": "number", "description": "Fixed term length (100)" },
        "totalEarnedUsdt": { "type": "number", "description": "Cumulative yield credited on this tranche" },
        "txHash": { "type": "string", "description": "Verified TRON transaction hash" },
        "status": { "type": "string", "enum": ["active", "completed", "paused"], "description": "Position status" },
        "lastPayoutDate": { "type": "string", "description": "Last UTC payout date key (YYYY-MM-DD)" },
        "startedAt": { "type": "string", "description": "Activation ISO timestamp" },
        "completedAt": { "type": "string", "description": "100-day completion ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Last update ISO timestamp" }
      },
      "required": ["id", "userId", "principalUsdt", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile data keyed by user UID"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Trading subscription records"
    },
    "/mt5_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Mt5Account" },
      "description": "MT5 account states and equity monitoring"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/WithdrawalRequest" },
      "description": "Client withdrawal requests and reservations"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable security and activity audit records"
    },
    "/email_verifications/{verificationId}": {
      "schema": { "$ref": "#/entities/EmailVerification" },
      "description": "Email OTP verification records"
    },
    "/user_yield_allocations/{userId}": {
      "schema": { "$ref": "#/entities/UserYieldAllocation" },
      "description": "Yield and performance pool allocations keyed by user UID"
    },
    "/yield_positions/{positionId}": {
      "schema": { "$ref": "#/entities/YieldPosition" },
      "description": "Individual verified fixed-capital 100-business-day yield positions"
    },
    "/yield_ledger/{ledgerId}": {
      "schema": { "$ref": "#/entities/YieldLedgerEntry" },
      "description": "Comprehensive yield ledger audit trail for deposits, distributions, and withdrawals"
    }
  }
}
